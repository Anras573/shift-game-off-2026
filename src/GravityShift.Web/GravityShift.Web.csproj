<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">
  <!--
    Browser host (Blazor WebAssembly + WebGL 2). This is what ships to itch.io:
    `dotnet publish -c Release` and upload the contents of publish/wwwroot as an HTML5 zip.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <OverrideHtmlAssetPlaceholders>true</OverrideHtmlAssetPlaceholders>
    <!-- itch.io serves files as-is (no Content-Encoding), so precompressed copies only bloat the zip. -->
    <CompressionEnabled>false</CompressionEnabled>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" Version="10.0.1" />
    <PackageReference
      Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer"
      Version="10.0.1"
      PrivateAssets="all"
    />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\engine\Yaeger\src\Engine\Yaeger.Browser\Yaeger.Browser.csproj" />
    <ProjectReference Include="..\GravityShift.Game\GravityShift.Game.csproj" />
  </ItemGroup>
</Project>
