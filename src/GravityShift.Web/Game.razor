@inject NavigationManager Nav
@implements IDisposable

<canvas id="yaeger-canvas" tabindex="0"></canvas>

@code {
    private BrowserRenderSurface? _renderSurface;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
            return;

        // Loads Yaeger's packaged JS interop module (_content/Yaeger.Browser/yaeger-browser.js).
        await YaegerBrowser.InitializeAsync(Nav.BaseUri);

        _renderSurface = new BrowserRenderSurface("yaeger-canvas")
        {
            ClearColor = new System.Numerics.Vector4(0.05f, 0.05f, 0.08f, 1f),
        };
        _renderSurface.Initialize();

        // Stop the page (and the itch.io iframe) scrolling when playing with arrows/space.
        BrowserInputState.SetPreventDefaultKeys(
            [Keys.Left, Keys.Right, Keys.Up, Keys.Down, Keys.Space]
        );

        var timeSource = new BrowserTimeSource();
        var game = new GravityShiftGame(new BrowserInputState(), _renderSurface, _renderSurface);

        // Playtesting shortcut: ?level=5 starts on the fifth level.
        var query = System.Web.HttpUtility.ParseQueryString(new Uri(Nav.Uri).Query);
        if (int.TryParse(query["level"], out var level) && level >= 1 && level <= game.LevelCount)
            game.LoadLevel(level - 1);

        // StartGameLoop calls BrowserInputState.BeginFrame/EndFrame around every tick.
        YaegerBrowser.StartGameLoop(timestampMs =>
        {
            timeSource.Advance(timestampMs);
            game.Update(timeSource.DeltaTime);
            game.Render();
        });
    }

    public void Dispose()
    {
        YaegerBrowser.StopGameLoop();
        _renderSurface?.Dispose();
    }
}
