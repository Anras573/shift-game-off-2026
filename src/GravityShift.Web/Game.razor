@inject NavigationManager Nav
@inject IJSRuntime JS
@implements IDisposable

<canvas id="yaeger-canvas" tabindex="0"></canvas>

@code {
    private const string HudFontFamily = "GravityShiftHud";
    private BrowserRenderSurface? _renderSurface;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
            return;

        // Loads Yaeger's packaged JS interop module (_content/Yaeger.Browser/yaeger-browser.js).
        await YaegerBrowser.InitializeAsync(Nav.BaseUri);

        _renderSurface = new BrowserRenderSurface("yaeger-canvas")
        {
            ClearColor = new System.Numerics.Vector4(0.05f, 0.05f, 0.08f, 1f),
        };
        _renderSurface.Initialize();

        // Pixel art: nearest-neighbour sampling keeps the 16x16 tiles crisp. Set before any
        // texture loads, then load them all up front so the first frame isn't missing any.
        _renderSurface.SetDefaultSampling(Yaeger.Platform.TextureSampling.Pixelated);
        await _renderSurface.PreloadAsync(GravityShift.Art.All);

        // Stop the page (and the itch.io iframe) scrolling when playing with arrows/space.
        BrowserInputState.SetPreventDefaultKeys(
            [Keys.Left, Keys.Right, Keys.Up, Keys.Down, Keys.Space]
        );

        // HUD font (DejaVu Sans Bold, see fonts/LICENSE-DejaVu.txt), registered via FontFace.
        await BrowserTextRenderSurface.LoadFontAsync(HudFontFamily, "fonts/DejaVuSans-Bold.ttf");

        // No screen shake for players who ask for reduced motion (OS setting), or with ?shake=0.
        var query = System.Web.HttpUtility.ParseQueryString(new Uri(Nav.Uri).Query);
        var reducedMotion =
            query["shake"] == "0"
            || await JS.InvokeAsync<bool>(
                "eval",
                "window.matchMedia('(prefers-reduced-motion: reduce)').matches"
            );

        // Sound loads now; browsers only let it play after the first key press or tap, and the
        // music starts then. A broken file just means playing without sound.
        GravityShift.Audio.GameSounds? sounds = null;
        try
        {
            sounds = await GravityShift.Audio.GameSounds.LoadAsync(new BrowserAudioOutput());
        }
        catch (Exception ex)
        {
            Console.Error.WriteLine($"Sound disabled: {ex.Message}");
        }

        var timeSource = new BrowserTimeSource();
        var game = new GravityShiftGame(
            new BrowserInputState(),
            _renderSurface,
            _renderSurface,
            textSurface: new BrowserTextRenderSurface(_renderSurface),
            hudFont: new Yaeger.Graphics.FontHandle(HudFontFamily),
            reducedMotion: reducedMotion,
            sounds: sounds,
            startScreen: GravityShift.Menus.GameScreen.Title
        );

        // Playtesting shortcut: ?level=5 skips the title and starts on the fifth level.
        if (int.TryParse(query["level"], out var level) && level >= 1 && level <= game.LevelCount)
            game.LoadLevel(level - 1);

        // StartGameLoop calls BrowserInputState.BeginFrame/EndFrame around every tick.
        YaegerBrowser.StartGameLoop(timestampMs =>
        {
            timeSource.Advance(timestampMs);
            game.Update(timeSource.DeltaTime);
            game.Render();
        });
    }

    public void Dispose()
    {
        YaegerBrowser.StopGameLoop();
        _renderSurface?.Dispose();
    }
}
