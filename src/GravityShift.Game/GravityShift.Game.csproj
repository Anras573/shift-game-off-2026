<Project Sdk="Microsoft.NET.Sdk">
  <!--
    All gameplay lives here. It references only Yaeger.Core (platform-agnostic), so the same
    code runs under the native desktop host and the Blazor WebAssembly host.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>GravityShift</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="GravityShift.Tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\engine\Yaeger\src\Engine\Yaeger.Core\Yaeger.Core.csproj" />
  </ItemGroup>
</Project>
