<Project Sdk="Microsoft.NET.Sdk">
  <!-- Native host (Silk.NET / OpenGL). Use this for day-to-day development. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>GravityShift</AssemblyName>
  </PropertyGroup>

  <!-- The HUD font and the textures live with the web build; copy them next to the desktop
       executable too (textures keep their relative "textures/..." paths). -->
  <ItemGroup>
    <None
      Include="..\GravityShift.Web\wwwroot\fonts\*"
      Link="Assets\Fonts\%(Filename)%(Extension)"
      CopyToOutputDirectory="PreserveNewest"
      CopyToPublishDirectory="PreserveNewest"
    />
    <None
      Include="..\GravityShift.Web\wwwroot\textures\*.png"
      Link="textures\%(Filename)%(Extension)"
      CopyToOutputDirectory="PreserveNewest"
      CopyToPublishDirectory="PreserveNewest"
    />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\engine\Yaeger\src\Engine\Yaeger\Yaeger.csproj" />
    <ProjectReference Include="..\GravityShift.Game\GravityShift.Game.csproj" />
  </ItemGroup>
</Project>
